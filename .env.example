# 스토어 넘버원 — 환경변수 템플릿
# 실제 값은 .env.local 에 넣고 절대 git 에 올리지 마세요. (독립 프로젝트)
# 값은 Supabase / Google Cloud 대시보드에서 발급받습니다.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용, 절대 브라우저/깃허브 노출 금지

# Google OAuth (Supabase Auth 에도 입력)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 관리자 (쉼표로 여러 명)
ADMIN_EMAILS=5ghxor@gmail.com
